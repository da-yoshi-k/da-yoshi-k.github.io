---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import {getCollection, getEntry} from "astro:content";
import ProfileHeader from "../components/ProfileHeader.astro";
import LinkCard from "../components/LinkCard.astro";

const links = (await getCollection("links")).sort(
  (a, b) => a.data.order - b.data.order
);
const profile = await getEntry("profile", "index");

// フォールバック用のデフォルト値
const profileData = profile?.data ?? {
  name: "Your Name",
  handleName: "@your-handle",
  bio: "自己紹介文をここに記入してください",
  skills: "あなたのスキル / 興味のある技術 / etc",
};
---

<BaseLayout title="da-yoshi-k">
  <main class="max-w-xl mx-auto px-6 py-14">
    <ProfileHeader {...profileData} />

    <ul class="mt-10 space-y-5">
      {
        links.map((link) => (
          <li>
            <LinkCard
              title={link.data.title}
              url={link.data.url}
              description={link.data.description}
              faviconDomain={link.data.faviconDomain}
              gaLabel={link.data.gaLabel}
              actionLabel={link.data.actionLabel}
              actionUrl={link.data.actionUrl}
              actionGaLabel={link.data.actionGaLabel}
            />
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
