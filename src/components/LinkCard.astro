---
const {title, url, description} = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="block rounded-2xl bg-white p-5
    shadow-sm
    hover:bg-zinc-50
    active:bg-zinc-100
    active:scale-[0.99]
    transition">
  <div class="text-base font-semibold">
    {title}
  </div>

  {description && <div class="mt-1 text-sm text-zinc-600">{description}</div>}
</a>
