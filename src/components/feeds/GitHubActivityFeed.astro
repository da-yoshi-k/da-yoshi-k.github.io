---
interface Props {
  username: string;
}

const { username } = Astro.props;
---

<div class="mt-3 pt-3 border-t border-zinc-200 dark:border-zinc-600">
  <h3 class="text-sm font-semibold text-zinc-700 dark:text-zinc-300 mb-3">
    📊 GitHub Contributions
  </h3>
  
  <!-- 草グラフ -->
  <div class="github-chart-wrapper">
    <img 
      src={`https://ghchart.rshah.org/${username}`}
      alt="GitHub Contribution Graph"
      class="w-full rounded"
    />
  </div>
</div>

<style>
  .github-chart-wrapper {
    background: transparent;
    border-radius: 0.5rem;
    overflow: hidden;
  }
  
  .github-chart-wrapper img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
