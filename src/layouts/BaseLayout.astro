---
const {title = "da-yoshi-k"} = Astro.props;
---

<!doctype html>
<html
  lang="ja"
  class="bg-zinc-50 text-zinc-900
    dark:bg-zinc-800 dark:text-zinc-200
    transition-colors duration-500">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-J49NYHYLGR"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-J49NYHYLGR");
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:title" content="自己紹介" />
    <meta property="og:description" content="Webエンジニア" />
    <meta property="og:url" content="https://da-yoshi-k.github.io/" />
    <meta property="og:image" content="https://da-yoshi-k.github.io/ogp.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="自己紹介" />
    <meta name="twitter:description" content="Webエンジニア" />
    <meta name="twitter:site" content="@da_yoshi_k" />
    <meta name="twitter:image" content="https://da-yoshi-k.github.io/ogp.png" />

    <title>{title}</title>

    <link rel="icon" href="/prof.png" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <script src="/theme-toggle.js" defer is:inline></script>
  </head>

  <body class="antialiased">
    <slot />
  </body>
</html>
